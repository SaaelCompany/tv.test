# ════════ Режимы ════════
DEBUG=false
XUI_MOCK_MODE=false
ROBOKASSA_MOCK=true

# ════════ 3x-ui ════════
XUI_URL=http://127.0.0.1:2053
XUI_API_TOKEN=
XUI_USERNAME=admin
XUI_PASSWORD=
XUI_INBOUND_ID=1
XUI_SUB_BASE_URL=http://127.0.0.1:2096
# Как часто подтягивать срок, трафик и статус из панели (секунды, 0 = только вручную)
XUI_SYNC_INTERVAL=120

# ════════ Robokassa (пока mock) ════════
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST_MODE=true
ROBOKASSA_HASH_TYPE=md5
ROBOKASSA_FISCAL_MODE=false

# ════════ Сайт ════════
BASE_URL=http://localhost:8000
SECRET_KEY=
COOKIE_SECURE=false
COOKIE_DOMAIN=
ADMIN_PASSWORD=
TRUSTED_HOSTS=localhost,127.0.0.1

# ════════ БД ════════
DATABASE_URL=sqlite:///./vpn_shop.db

# ════════ SMTP (опционально) ════════
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
